			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "弹窗";
			footerText = "Safari 打不开网页时会弹「打不开该网页 / 因为网址无效」，必须点「好」。开启后按文本精准命中该对话框并拆除，改底部 toast。";
		},
		{
			cell = PSSwitchCell;
			label = "拦截「打不开该网页」弹窗";
