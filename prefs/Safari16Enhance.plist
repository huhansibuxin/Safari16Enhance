			key = "killReader";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "返回";
			footerText = "iOS 16 的 WebKit 无 bfcache 开关（已实测确认）。开启后：返回时吞掉多余的一次 reload（只吞同 URL，不影响点新链接），并注入 JS 复位页面残留的滚动锁 —— 部分 SPA 页面返回后滑不动的根因就在这里。";
		},
		{
			cell = PSSwitchCell;
			label = "返回后修复滑动";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "fixBackScroll";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "诊断探针";
			footerText = "日志固定写入 Safari 容器：<容器>/Documents/Safari16Enhance.log，启动时打印实际路径。功能确认正常后可关闭。";
		},
		{
			cell = PSSwitchCell;
			label = "启用运行时探针";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "probeEnabled";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "功能说明";
			footerText = "1. 弹窗拦截：只保留精准命中，Safari 自绘的 SFDialogView 按文本拆除，网页自己的 JS 对话框不受影响。
2. 「App 内打开」浮层：JS 清网页自绘的绿色胶囊浮层 + MutationObserver 见到 apple-itunes-app meta 就删。
   （Smart App Banner 的原生拦截链路已全部移除，见下方说明。）
3. 阅读器：白名单精准命中已实测确认的可用性判定，压成 NO。
4. 返回：后退窗口内吞掉多余 reload + JS 复位页面滚动锁。
5. 在 App 中打开：让 Safari 拿不到 WBSAppLink，「微软必应 APP 打开 / 浏览器 继续」这类卡片不再出现。
6. 地址栏手势：禁用底部地址栏上的左右滑动切页，防误触。

（本插件不修改 WKWebView 的 configuration / processContentController / processPool，也不 hook WebKit 导航决策，避免影响第三方扩展的脚本注入与权限流程。）

日志：容器 Documents/Safari16Enhance.log（超 2MB 轮转为 .1）。";
		}
	);
}
