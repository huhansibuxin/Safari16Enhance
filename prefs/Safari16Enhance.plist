{
	title = "Safari 16 增强";
	items = (
		{
			cell = PSGroupCell;
			label = "总开关";
			footerText = "独立实现（非 SafariPlus / 非 SafariX）。仅在 MobileSafari 进程内生效。";
		},
		{
			cell = PSSwitchCell;
			label = "启用插件";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "enabled";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "弹窗";
			footerText = "Safari 打不开网页时会弹「打不开该网页 / 因为网址无效」，必须点「好」。开启后按文本精准命中该对话框并拆除，改底部 toast。";
		},
		{
			cell = PSSwitchCell;
			label = "拦截「打不开该网页」弹窗";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "suppressErrorAlert";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "推广横幅";
			footerText = "两种横幅分开处理：
① 顶部 Smart App Banner（Safari 原生，由网页 apple-itunes-app meta 触发）—— 精准 hook TabDocument / BrowserController 的 8 个具体方法，让横幅对象到不了渲染层。
② 网页自绘的「App 内打开 / Open in app」浮层 —— JS 清（纯 DOM 操作）。";
		},
		{
			cell = PSSwitchCell;
			label = "移除「App 内打开」浮层";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killOpenInApp";
			default = YES;
		},
		{
			cell = PSSwitchCell;
			label = "拦截顶部 Smart App Banner";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killSmartBanner";
			default = YES;
		},
		{
			cell = PSSwitchCell;
			label = "不弹「打开 App / 继续」卡片";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killAppLinkPrompt";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "地址栏手势";
			footerText = "底部地址栏的真实结构是胶囊标签栏（SFCapsuleNavigationBar / SFCapsuleCollectionView），横滑切页靠它的横向滚动实现。默认模式只吃掉横向分量，纵向手势与其他交互保留。若仍会切页，再打开「硬模式」。";
		},
		{
			cell = PSSwitchCell;
			label = "禁用地址栏左右滑动切页";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killURLBarSwipe";
			default = YES;
		},
		{
			cell = PSSwitchCell;
			label = "硬模式（彻底禁用胶囊滚动）";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "urlBarSwipeHardMode";
			default = NO;
		},
		{
			cell = PSGroupCell;
			label = "阅读器";
			footerText = "Safari 检测到文章页时会在地址栏临时把网址换成「阅读器可用」，并显示阅读器按钮。开启后彻底关闭该判定。";
		},
		{
			cell = PSSwitchCell;
			label = "关闭「阅读器可用」提示";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killReader";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "诊断探针";
			footerText = "日志固定写入 Safari 容器：<容器>/Documents/Safari16Enhance.log，启动时打印实际路径。默认关闭；只有排查问题时才打开。关闭时仅记录「真正发生了拦截」的事件（弹窗拆除 / 横幅丢弃 / 手势类名 dump 不记）。";
		},
		{
			cell = PSSwitchCell;
			label = "启用运行时探针";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "probeEnabled";
			default = NO;
		},
		{
			cell = PSGroupCell;
			label = "功能说明";
			footerText = "1. 弹窗拦截：只保留精准命中，Safari 自绘的 SFDialogView 按文本拆除，网页自己的 JS 对话框不受影响。
2. Smart App Banner：精准 hook TabDocument（setAppBanner: / appBanner / didFindAppBannerWithContent: / setAppSuggestionBanner:isPinned: / setStoreBannersAreDisabled:）与 BrowserController（检查完成 / 钉顶 / 移除）共 8 个方法，不做类名通扫。
3. 「App 内打开」浮层：JS 清网页自绘浮层 + MutationObserver 见到 apple-itunes-app meta 就删 + 捕获阶段拦非 http(s) scheme 的点击。
4. 阅读器：白名单精准命中已实测确认的可用性判定，压成 NO。
5. 在 App 中打开：让 Safari 拿不到 WBSAppLink，「微软必应 APP 打开 / 浏览器 继续」这类卡片不再出现。
6. 地址栏手势：禁用底部地址栏上的左右滑动切页，防误触。

（本插件不修改 WKWebView 的 configuration / userContentController / processPool，也不 hook WebKit 导航决策并手工回调 decisionHandler，避免影响第三方扩展的脚本注入与权限流程。）

日志：容器 Documents/Safari16Enhance.log（超 2MB 轮转为 .1）。运行时探针默认关闭，关闭时只记录真正发生的拦截事件。";
		}
	);
}
