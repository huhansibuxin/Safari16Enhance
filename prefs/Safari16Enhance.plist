		{
			cell = PSSwitchCell;
			label = "启用运行时探针";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "probeEnabled";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "功能说明";
			footerText = "1. 自定义搜索引擎：注入自建 SearchEngineInfo 并强制作为默认引擎（默认元宝搜索）。\n2. 弹窗拦截：只保留精准命中，Safari 自绘的 SFDialogView 按文本拆除，网页自己的 JS 对话框不受影响。\n3. 推广横幅：JS 清网页自绘「App 内打开」浮层 + 移除 apple-itunes-app meta + 原生 Smart App Banner 直接拆除。\n4. 阅读器：白名单精准命中已实测确认的可用性判定，压成 NO。\n5. 返回：iOS 16 无 bfcache SPI，改为返回后主动复位滚动视图。\n\n日志：容器 Documents/Safari16Enhance.log（超 2MB 轮转为 .1）。";
		}
	);
}
