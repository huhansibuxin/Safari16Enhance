{
	title = "Safari 16 增强";
	items = (
		{
			cell = PSGroupCell;
			label = "总开关";
			footerText = "独立实现（非 SafariPlus / 非 SafariX）。仅在 MobileSafari 进程内生效。";
		},
		{
			cell = PSSwitchCell;
			label = "启用插件";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "enabled";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "自定义搜索引擎";
			footerText = "开启后 Safari 地址栏搜索改用下方引擎。搜索 URL 必须包含 {searchTerms}。改动后请上滑杀掉 Safari 再打开。";
		},
		{
			cell = PSSwitchCell;
			label = "启用自定义搜索引擎";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "customEngineEnabled";
			default = YES;
		},
		{
			cell = PSTextFieldCell;
			label = "引擎名称";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "customEngineName";
			default = "元宝搜索";
			placeholder = "元宝搜索";
		},
		{
			cell = PSTextFieldCell;
			label = "搜索 URL";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "customEngineURL";
			default = "https://so.qq.com/isearch?query={searchTerms}";
			placeholder = "https://so.qq.com/isearch?query={searchTerms}";
		},
		{
			cell = PSGroupCell;
			label = "常用模板（直接复制）";
			footerText = "元宝　https://so.qq.com/isearch?query={searchTerms}\n百度　https://www.baidu.com/s?wd={searchTerms}\nGoogle　https://www.google.com/search?q={searchTerms}\nBing　https://www.bing.com/search?q={searchTerms}";
		},
		{
			cell = PSGroupCell;
			label = "错误弹窗";
			footerText = "Safari 打不开网页时强制弹「打不开该网页 / 因为网址无效」对话框，必须点「好」。开启后拦截并改成底部 toast。";
		},
		{
			cell = PSSwitchCell;
			label = "拦截「打不开该网页」弹窗";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "suppressErrorAlert";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "阅读器";
			footerText = "Safari 检测到文章页时会在地址栏临时把网址换成「阅读器可用」，并显示阅读器按钮。开启后彻底关闭该判定，提示与按钮都不再出现。";
		},
		{
			cell = PSSwitchCell;
			label = "关闭「阅读器可用」提示";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killReader";
			default = YES;
		},
		{
			cell = PSSwitchCell;
			label = "深度扫描全部 Reader 类（兜底）";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "readerDeepScan";
			default = NO;
		},
		{
			cell = PSGroupCell;
			label = "返回缓存";
			footerText = "从搜索页点进网页后返回，Safari 默认重新拉网络（很慢）。开启后启用 WebKit 后退/前进缓存（bfcache），返回直接恢复上一页内存状态，不再重新加载。";
		},
		{
			cell = PSSwitchCell;
			label = "返回时使用缓存（不重新加载）";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "backForwardCache";
			default = YES;
		},
		{
			cell = PSSwitchCell;
			label = "返回后抑制多余重载";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "blockReloadOnBack";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "诊断探针";
			footerText = "日志固定写入 Safari 容器：<容器>/Documents/Safari16Enhance.log，启动时打印实际路径。功能确认正常后可关闭。";
		},
		{
			cell = PSSwitchCell;
			label = "启用运行时探针";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "probeEnabled";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "功能说明";
			footerText = "1. 自定义搜索引擎：注入自建 SearchEngineInfo 并强制作为默认引擎（默认元宝搜索）。\n2. 弹窗拦截：Safari 自绘的 SFDialogView（打不开该网页 / 网址无效）按文本精准拆除，改 toast；网页自己的 JS 对话框不受影响。\n3. 阅读器击杀：白名单精准命中已实测确认的可用性判定，压成 NO；可选深度扫描兜底。\n4. 返回缓存：iOS 16 的 WKPreferences 无 bfcache 开关（已实测确认），改为在后退窗口内抑制多余 reload。\n5. 探针：记录 SFDialog 文本、alert 链路、Reader 命中清单、bfcache 候选 dump。\n\n日志：容器 Documents/Safari16Enhance.log（超 2MB 轮转为 .1）。";
		}
	);
}
