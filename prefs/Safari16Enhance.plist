		},
		{
			cell = PSGroupCell;
			label = "推广横幅";
			footerText = "「App 内打开」绿色胶囊浮层是网页自己用 HTML 画的，开启后用 JS 清掉（纯 DOM 操作）。
注意：顶部那条「Dark Night 已请求额外权限 / 检查」是 Safari 自己的扩展权限提示条，不属于本插件范围，也无法用 tweak 拦掉 —— 它是系统按「扩展 → 网站访问权限」的设置逐站点发出的。";
		},
		{
			cell = PSSwitchCell;
			label = "移除「App 内打开」浮层";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killOpenInApp";
			default = YES;
		},
		{
			cell = PSSwitchCell;
			label = "不弹「打开 App / 继续」卡片";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killAppLinkPrompt";
			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "地址栏手势";
			footerText = "底部地址栏的真实结构是胶囊标签栏（SFCapsuleNavigationBar / SFCapsuleCollectionView），横滑切页靠它的横向滚动实现。默认模式只吃掉横向分量，纵向手势与其他交互保留。若仍会切页，再打开「硬模式」。";
		},
		{
			cell = PSSwitchCell;
			label = "禁用地址栏左右滑动切页";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "killURLBarSwipe";
			default = YES;
		},
		{
			cell = PSSwitchCell;
			label = "硬模式（彻底禁用胶囊滚动）";
			defaults = "com.huhansibuxin.safari16enhance";
			key = "urlBarSwipeHardMode";
			default = NO;
		},
		{
			cell = PSGroupCell;
			label = "阅读器";
			footerText = "Safari 检测到文章页时会在地址栏临时把网址换成「阅读器可用」，并显示阅读器按钮。开启后彻底关闭该判定。";
		},
		{
			cell = PSSwitchCell;
			label = "关闭「阅读器可用」提示";
