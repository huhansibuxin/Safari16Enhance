			default = YES;
		},
		{
			cell = PSGroupCell;
			label = "自定义搜索引擎";
			footerText = "开启后 Safari 地址栏搜索改用下方引擎。搜索 URL 必须包含 {searchTerms}。改动后请上滑杀掉 Safari 再打开。";
		},
		{
			cell = PSSwitchCell;
			label = "启用自定义搜索引擎";
